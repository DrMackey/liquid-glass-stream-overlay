//
//  TwitchSecrets.xcconfig
//  liquid-glass-stream-overlay
//
//  Этот файл НЕ содержит секретов и попадает в Git — в нём только имена
//  ключей и подключение локального файла. Реальные значения лежат в
//  TwitchSecrets-Debug.local.xcconfig рядом с ним, он в .gitignore и в Git не попадает.
//
//  Что сделать при первом клонировании:
//    1. Скопировать TwitchSecrets-Debug.local.example.xcconfig в TwitchSecrets-Debug.local.xcconfig
//    2. Вписать туда значения для своей среды
//
//  Переключение среды: Debug -> TwitchSecrets-Debug.xcconfig (mock/тест),
//  Release -> TwitchSecrets-Release.xcconfig (боевой Twitch).
//
//  Ключи попадают в Info.plist как $(TWITCH_*) и читаются в коде через
//  Config в Bridges/TwitchChatManager.swift.
//

TWITCH_CHANNEL =
TWITCH_HELIX_CLIENT_ID =
TWITCH_HELIX_BEARER_TOKEN =

#include? "TwitchSecrets-Debug.local.xcconfig"
